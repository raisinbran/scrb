{
  "name": "@scrb/export",
  "version": "0.1.0",
  "private": true,
  "description": "Meeting Scribe export: one document layout rendered to DOCX and printable HTML/PDF.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "docx": "9.11.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "parse5": "8.0.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
