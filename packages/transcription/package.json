{
  "name": "@scrb/transcription",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Meeting Scribe transcription backend: audio import, whisper.cpp and sherpa-onnx workers, final and live passes, voice-profile matching",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:ffmpeg": "scripts/build-ffmpeg.sh",
    "build:sidecar": "scripts/build-sherpa-sidecar.sh"
  },
  "engines": { "node": ">=22" },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "5.7.2",
    "vitest": "5.0.5"
  }
}
