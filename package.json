{
  "name": "meeting-scribe",
  "version": "0.1.0",
  "private": true,
  "description": "Local, offline meeting recorder for Windows 11 and Apple Silicon Macs.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "install-electron",
    "dev": "npm run dev -w @scrb/desktop",
    "build": "npm run build -w @scrb/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:smoke": "npm run test:smoke -w @scrb/desktop",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:boundaries"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
